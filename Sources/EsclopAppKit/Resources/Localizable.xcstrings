    "strip location": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "sense ubicació"
          }
        }
      }
    },
    "strip metadata": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "sense metadades"
          }
        }
      }
    },
    "“%@” did not get through.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no ha arribat al final."
          }
        }
      }
    },
    "“%@” does not match the filter: nothing ran.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no coincideix amb el filtre: no s’ha executat res."
          }
        }
      }
    },
    "“%@” does not match: it is left alone.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no hi coincideix: no es toca."
          }
        }
      }
    },
    "“%@” is not an aspect ratio. Write it like 16:9 or 4:5.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no és una proporció. Escriu-la com 16:9 o 4:5."
          }
        }
      }
    },
    "“%@” matches: the pipeline runs on it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hi coincideix: el pipeline s’hi executa."
          }
        }
      }
    },
    "“…” always stays, so the options are one click away.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "“…” sempre hi és, perquè les opcions quedin a un clic."
          }
        }
      }
    },
    "⋯ %d unchanged lines": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "⋯ %d línies sense canvis"
          }
        }
      }
    },
    "⋯ 1 unchanged line": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "⋯ 1 línia sense canvis"
          }
        }
      }
    },
    "⌥ keeps both": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ conserva tots dos"
          }
        }
      }
    }
  },
  "version": "1.0"
