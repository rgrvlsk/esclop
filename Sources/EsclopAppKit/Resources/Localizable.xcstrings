          }
        }
      }
    },
    "step.if.durationGreaterThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "més llarg que aquests segons (esclop)"
          }
        }
      }
    },
    "step.if.durationLowerThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
