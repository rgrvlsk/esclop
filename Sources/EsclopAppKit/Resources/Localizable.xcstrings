{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ answered in %d ms: protocol %@, %d tools, jobs run %@.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ha respost en %d ms: protocol %@, %d eines, les feines s’executen %@."
          }
        }
      }
    },
    "%@ %@ answered in %d ms: protocol %@, %d tools, jobs run in the app.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ha respost en %d ms: protocol %@, %d eines, les feines s’executen a l’app."
          }
        }
      }
    },
    "%@ %@ answered in %d ms: protocol %@, %d tools.": {
      "localizations": {
        "ca": {
