          "stringUnit": {
            "state": "translated",
            "value": "No s’esperava `)`: no hi ha cap `(` per tancar."
          }
        }
      }
    },
    "Unknown front matter key `%@`. Did you mean `%@`?": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Clau de capçalera desconeguda: `%@`. Volies dir `%@`?"
