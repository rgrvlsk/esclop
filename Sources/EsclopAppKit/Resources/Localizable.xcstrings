    "Unknown front matter key `%@`. Known keys: %@.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Clau de capçalera desconeguda: `%@`. Les claus conegudes són: %@."
          }
        }
      }
    },
    "Unknown location `%@`. Did you mean `%@`? Quote it if it is a file name.": {
      "localizations": {
        "ca": {
          "stringUnit": {
