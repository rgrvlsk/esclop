      }
    },
    "step.runScript.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa un script de shell amb el fitxer com a `$1`. Si escriu el camí d’un fitxer del mateix tipus, el pipeline continua amb aquell fitxer."
          }
        }
      }
    },
    "step.runShortcut.name": {
