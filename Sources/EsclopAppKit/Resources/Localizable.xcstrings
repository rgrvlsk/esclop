    "L'Esclop": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Esclop"
          }
        }
      }
    },
    "L'Esclop created %@ when it connected, and the file holds nothing else, so it will be removed.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Esclop va crear %@ en connectar-lo, i el fitxer no conté res més, així que s’eliminarà."
          }
        }
      }
    },
    "L'Esclop is in the menu bar": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Esclop és a la barra de menús"
          }
        }
      }
    },
    "L'Esclop optimises what you copy as soon as you copy it. Originals are kept for %@ and can be restored from the menu.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Esclop optimitza el que copies tan bon punt ho copies. Els originals es conserven durant %@ i es poden restaurar des del menú."
          }
        }
      }
    },
    "L'Esclop was not in the config of %@.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Esclop no era a la configuració de %@."
          }
        }
      }
    },
    "L'Esclop will edit %@. Only the esclop entry changes: other servers, comments and formatting stay as they are.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Esclop editarà %@. Només canvia l’entrada d’esclop: els altres servidors, els comentaris i el format queden com estan."
          }
        }
      }
    },
