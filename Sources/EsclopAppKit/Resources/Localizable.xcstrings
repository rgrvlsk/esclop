    "step.lowerBitrate.location": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "on va el resultat: `inPlace` substitueix el fitxer (se’n conserva una còpia de seguretat), `sameFolder` el desa al costat de l’original, `temporaryFolder`, o una plantilla de camí com `\"~/Exports/%f\"`"
          }
        }
      }
    },
    "step.lowerBitrate.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixa la taxa de bits de l’àudio. Mai l’apuja."
          }
