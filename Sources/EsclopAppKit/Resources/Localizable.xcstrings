    },
    "step.if.regex": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "expressió regular que s’aplica al nom del fitxer; tota en minúscules no distingeix majúscules. Els grups de captura passen a ser `$1`, `$2`"
          }
        }
      }
    },
    "step.if.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua només si es compleixen totes les condicions; si no, el fitxer s’atura aquí sense fer soroll. No hi ha `else`."
          }
        }
      }
    },
    "step.if.types": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "extensions o tipus, separats per espais: `jpeg png webp`, `image`, `video`"
          }
        }
      }
    },
    "step.if.widthGreaterThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "més ample que aquests píxels"
          }
        }
      }
    },
    "step.if.widthLowerThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "més estret que aquests píxels"
          }
        }
      }
    },
    "step.ifNot.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
