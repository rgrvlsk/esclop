    },
    "%@ does not exist yet. L'Esclop will create it with only the esclop entry.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encara no existeix. L’Esclop el crearà només amb l’entrada d’esclop."
          }
        }
      }
    },
    "%@ does not parse, so it is left alone: %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es pot llegir, així que no es toca: %@"
          }
        }
      }
    },
    "%@ exported documents": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
