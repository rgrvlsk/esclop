    },
    "step.if.fileSizeGreaterThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "el fitxer fa més d’aquests bytes"
          }
        }
      }
    },
    "step.if.fileSizeLowerThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "el fitxer fa menys d’aquests bytes"
          }
        }
      }
    },
    "step.if.heightGreaterThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "més alt que aquests píxels"
          }
        }
      }
    },
    "step.if.heightLowerThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "més baix que aquests píxels"
          }
        }
      }
    },
    "step.if.minFileSize": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "el fitxer fa com a mínim aquesta mida, per exemple `100kb`"
          }
        }
      }
    },
    "step.if.minResolution": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "tots dos costats fan com a mínim això, per exemple `640x480` (compta el primer nombre)"
          }
        }
      }
    },
    "step.if.nameContains": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "el nom del fitxer conté aquest text (sense distingir majúscules)"
          }
