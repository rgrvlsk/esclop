      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfés, restaura l’original"
          }
        }
      }
    },
    "Unexpected `%@`. A step starts with its name, e.g. `optimise` or `convert(to: webp)`.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’esperava `%@`. Un pas comença amb el seu nom, per exemple `optimise` o `convert(to: webp)`."
          }
        }
      }
    },
    "Unexpected `)`: there is no `(` to close.": {
      "localizations": {
