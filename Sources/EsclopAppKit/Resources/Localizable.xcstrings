    "step.optimise.adaptive": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "deixa que canviï el format quan el fitxer queda més petit (de PNG a JPEG i a l’inrevés)"
          }
        }
      }
    },
    "step.optimise.compression": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "quanta compressió aplica, de 5 (millor qualitat) a 100 (fitxer més petit), `adaptive` per triar-ho per a cada fitxer o `auto` per seguir l’opció de l’app"
          }
        }
      }
    },
    "step.optimise.dpi": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "només PDF: redueix les imatges a aquesta resolució. 300 conserva la qualitat d’impressió, 150 és per llegir en pantalla i 72 és la més petita"
          }
        }
      }
    },
    "step.optimise.encoder": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "imatges, PDF i àudio: `medium`, `aggressive` o `lossless`; vídeo: `fast` (maquinari), `slowHighQuality` (programari, més petit) o `visuallyLossless`"
          }
        }
      }
    },
    "step.optimise.location": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "on va el resultat: `inPlace` substitueix el fitxer (se’n conserva una còpia de seguretat), `sameFolder` el desa al costat de l’original, `temporaryFolder`, o una plantilla de camí com `\"~/Exports/%f\"`"
          }
        }
      }
    },
    "step.optimise.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimeix el fitxer i en conserva el format i la mida en píxels."
          }
        }
      }
    },
    "step.removeAudio.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treu la pista d’àudio."
          }
        }
      }
    },
    "step.rename.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia el nom del fitxer dins la seva carpeta. Si el nom nou no té extensió, es conserva la que tenia."
          }
        }
      }
    },
    "step.rename.to": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "nom nou o plantilla, per exemple `\"%y-%m-%d %f\"`"
          }
        }
      }
    },
    "step.runScript.code": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "una línia de zsh, per exemple `\"sips -Z 800 $1\"`; no pot contenir `->`"
          }
        }
      }
    },
    "step.runScript.path": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "fitxer de l’script (els executables s’executen directament; els altres, amb zsh)"
