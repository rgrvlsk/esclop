      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Converteix cada pàgina d’un PDF en una imatge. Si només en té una, els passos següents continuen amb aquella imatge."
          }
        }
      }
    },
    "step.fork.location": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "desa aquí la còpia bifurcada; si no s’indica, queda en una carpeta temporal"
          }
        }
      }
    },
    "step.fork.summary": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra també el resultat fins ara com un segon resultat i continua amb el mateix fitxer."
          }
        }
      }
    },
    "step.if.copiedBy": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "el contingut del porta-retalls ve d’aquesta app (nom o identificador de paquet, o una part)"
          }
        }
      }
    },
    "step.if.dpiGreaterThan": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "resolució per sobre d’aquests DPI"
