{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressEvent",
  "description": "Progress line, zero or more per request before its response.",
  "type": "object",
  "properties": {
    "event": {
      "description": "Always `\"progress\"`.",
      "type": "string"
    },
    "fraction": {
      "description": "0..=1, non-decreasing for a request.",
      "type": "number",
      "format": "float"
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "description": "Short machine name of the current stage (`decode`, `quantise`, `encode`, `search`...).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "event",
    "fraction"
  ]
}
